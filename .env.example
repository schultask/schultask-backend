# Copy to apps/backend/.env for running the backend on the host (pnpm dev)
# against the dockerized data layer (infra/docker-compose.dev.yml).

PORT=3001
DATABASE_URL=postgresql://schultask:changeme@localhost:5433/schultask
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# MinIO runs in Docker even in local dev (infra/docker-compose.dev.yml
# publishes 9000/9001) — access key/secret are the MINIO_ROOT_USER/PASSWORD
# from infra/.env.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=schultask
MINIO_SECRET_KEY=changeme-min-8-chars
MINIO_BUCKET=schultask-thumbnails

# Used by the AI course builder (POST /ai/generate-outline) — no default,
# the app doesn't fail to boot without it, only outline-generation jobs do.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
